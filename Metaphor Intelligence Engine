          output: "Lesson Plan: Start with the biological impact, trace the tool used to fix it, map the resource cost, and end with the physics limit."
        });
      } else {
        resolve({
          topic,
          module: 'strategy',
          protocol: protocol.name,
          risk_assessment: {
            hidden_externalities: "Suppression of long-term environmental costs for short-term gain.",
            structural_fragility: "Just-In-Time optimization lacks 'Damage Control' buffers.",
