  return new Promise((resolve) => {
    setTimeout(() => {
      if (type === 'pedagogical') {
        resolve({
          topic,
          module: 'pedagogical',
          dimensions: [
            { id: 'D1', title: 'Biological Anchor', science: 'Evolutionary Mismatch', character: 'Captain America vs Hulk', analysis: `How ${topic} triggers ancient stress responses in modern biology.`, lesson: 'Identify the friction between hardware (body) and software (environment).' },
