import React, { useState, useEffect } from 'react';
import { Activity, TrendingUp, Heart, Leaf, Briefcase, DollarSign, ExternalLink, Clock } from 'lucide-react';

const ImpactTracker = () => {
  const [selectedInitiative, setSelectedInitiative] = useState('all');
  const [transactions, setTransactions] = useState([]);
  const [stats, setStats] = useState({
    health: { total: 0, count: 0, trend: 0 },
    environmental: { total: 0, count: 0, trend: 0 },
    employment: { total: 0, count: 0, trend: 0 },
    debt: { total: 0, count: 0, trend: 0 }
  });

  // Simulated blockchain data - replace with actual blockchain API
  useEffect(() => {
    const generateTransaction = () => {
      const initiatives = ['health', 'environmental', 'employment', 'debt'];
      const initiative = initiatives[Math.floor(Math.random() * initiatives.length)];
      const amount = (Math.random() * 5000 + 100).toFixed(2);
      
      return {
        id: `0x${Math.random().toString(16).substr(2, 40)}`,
        initiative,
        amount: parseFloat(amount),
        timestamp: new Date(),
        hash: `0x${Math.random().toString(16).substr(2, 64)}`,
        status: 'confirmed'
      };
    };

    // Initial transactions
    const initialTxs = Array.from({ length: 15 }, generateTransaction)
      .sort((a, b) => b.timestamp - a.timestamp);
    setTransactions(initialTxs);

    // Add new transaction every 8 seconds
    const interval = setInterval(() => {
      setTransactions(prev => {
        const newTx = generateTransaction();
        return [newTx, ...prev].slice(0, 50);
      });
    }, 8000);

    return () => clearInterval(interval);
  }, []);

  // Calculate stats
  useEffect(() => {
    const newStats = {
      health: { total: 0, count: 0, trend: 12.5 },
      environmental: { total: 0, count: 0, trend: 8.3 },
      employment: { total: 0, count: 0, trend: 15.7 },
      debt: { total: 0, count: 0, trend: 9.2 }
    };

    transactions.forEach(tx => {
      newStats[tx.initiative].total += tx.amount;
      newStats[tx.initiative].count += 1;
    });

    setStats(newStats);
  }, [transactions]);

  const initiatives = [
    { id: 'health', name: 'Health Initiatives', icon: Heart, color: 'from-red-500 to-pink-500', bg: 'bg-red-50', border: 'border-red-200' },
    { id: 'environmental', name: 'Environmental', icon: Leaf, color: 'from-green-500 to-emerald-500', bg: 'bg-green-50', border: 'border-green-200' },
    { id: 'employment', name: 'Employment', icon: Briefcase, color: 'from-blue-500 to-cyan-500', bg: 'bg-blue-50', border: 'border-blue-200' },
    { id: 'debt', name: 'Debt Relief', icon: DollarSign, color: 'from-purple-500 to-violet-500', bg: 'bg-purple-50', border: 'border-purple-200' }
  ];

  const filteredTransactions = selectedInitiative === 'all' 
    ? transactions 
    : transactions.filter(tx => tx.initiative === selectedInitiative);

  const totalImpact = Object.values(stats).reduce((sum, stat) => sum + stat.total, 0);

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="mb-8 text-center">
          <div className="flex items-center justify-center gap-3 mb-4">
            <Activity className="w-10 h-10 text-cyan-400" />
            <h1 className="text-4xl font-bold text-white">Live Impact Tracker</h1>
          </div>
          <p className="text-slate-300 text-lg">Real-time blockchain transactions driving positive change</p>
          <div className="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-green-500/20 border border-green-500/30 rounded-full">
            <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span className="text-green-300 text-sm font-medium">Live on-chain data</span>
          </div>
        </div>

        {/* Total Impact */}
        <div className="mb-8 bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 rounded-2xl p-6">
          <div className="text-center">
            <p className="text-slate-400 text-sm mb-2">Total Ecosystem Impact</p>
            <p className="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">
              ${totalImpact.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </p>
            <p className="text-slate-400 text-sm mt-2">{transactions.length} transactions tracked</p>
          </div>
        </div>

        {/* Initiative Cards */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {initiatives.map(initiative => {
            const Icon = initiative.icon;
            const stat = stats[initiative.id];
            return (
              <div 
                key={initiative.id}
                className={`${initiative.bg} border ${initiative.border} rounded-xl p-5 cursor-pointer transition-all hover:shadow-lg hover:scale-105 ${selectedInitiative === initiative.id ? 'ring-2 ring-offset-2 ring-offset-slate-900' : ''}`}
                onClick={() => setSelectedInitiative(selectedInitiative === initiative.id ? 'all' : initiative.id)}
              >
                <div className="flex items-start justify-between mb-3">
                  <div className={`p-2 rounded-lg bg-gradient-to-br ${initiative.color}`}>
                    <Icon className="w-5 h-5 text-white" />
                  </div>
                  <div className="flex items-center gap-1 text-green-600">
                    <TrendingUp className="w-4 h-4" />
                    <span className="text-xs font-semibold">+{stat.trend}%</span>
                  </div>
                </div>
                <h3 className="text-slate-700 font-semibold text-sm mb-2">{initiative.name}</h3>
                <p className="text-2xl font-bold text-slate-900 mb-1">
                  ${stat.total.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
                </p>
                <p className="text-slate-600 text-xs">{stat.count} transactions</p>
              </div>
            );
          })}
        </div>

        {/* Filter Tabs */}
        <div className="flex flex-wrap gap-2 mb-6">
          <button
            onClick={() => setSelectedInitiative('all')}
            className={`px-4 py-2 rounded-lg font-medium transition-all ${
              selectedInitiative === 'all' 
                ? 'bg-white text-slate-900' 
                : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
            }`}
          >
            All Initiatives
          </button>
          {initiatives.map(init => (
            <button
              key={init.id}
              onClick={() => setSelectedInitiative(init.id)}
              className={`px-4 py-2 rounded-lg font-medium transition-all ${
                selectedInitiative === init.id 
                  ? 'bg-white text-slate-900' 
                  : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
              }`}
            >
              {init.name}
            </button>
          ))}
        </div>

        {/* Transaction Feed */}
        <div className="bg-slate-800/50 backdrop-blur border border-slate-700 rounded-2xl p-6">
          <h2 className="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <Clock className="w-5 h-5 text-cyan-400" />
            Recent Transactions
          </h2>
          <div className="space-y-3 max-h-[600px] overflow-y-auto">
            {filteredTransactions.map((tx, index) => {
              const initiative = initiatives.find(i => i.id === tx.initiative);
              const Icon = initiative.icon;
              const timeAgo = Math.floor((new Date() - tx.timestamp) / 1000);
              const timeStr = timeAgo < 60 ? `${timeAgo}s ago` : `${Math.floor(timeAgo / 60)}m ago`;
              
              return (
                <div 
                  key={tx.id}
                  className={`bg-slate-700/50 border border-slate-600 rounded-lg p-4 hover:bg-slate-700 transition-all ${
                    index === 0 ? 'animate-[fadeIn_0.5s_ease-in]' : ''
                  }`}
                >
                  <div className="flex items-center justify-between mb-2">
                    <div className="flex items-center gap-3">
                      <div className={`p-2 rounded-lg bg-gradient-to-br ${initiative.color}`}>
                        <Icon className="w-4 h-4 text-white" />
                      </div>
                      <div>
                        <p className="text-white font-semibold">{initiative.name}</p>
                        <p className="text-slate-400 text-xs">{timeStr}</p>
                      </div>
                    </div>
                    <div className="text-right">
                      <p className="text-xl font-bold text-green-400">${tx.amount.toLocaleString()}</p>
                      <div className="flex items-center gap-1 text-green-400 text-xs">
                        <div className="w-1.5 h-1.5 bg-green-400 rounded-full"></div>
                        Confirmed
                      </div>
                    </div>
                  </div>
                  <div className="flex items-center justify-between text-xs">
                    <p className="text-slate-400 font-mono truncate flex-1 mr-2">
                      {tx.hash.substring(0, 20)}...{tx.hash.substring(tx.hash.length - 6)}
                    </p>
                    <a 
                      href={`#${tx.hash}`}
                      className="flex items-center gap-1 text-cyan-400 hover:text-cyan-300"
                      onClick={(e) => e.preventDefault()}
                    >
                      View
                      <ExternalLink className="w-3 h-3" />
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Footer Note */}
        <div className="mt-8 text-center text-slate-400 text-sm">
          <p>All transactions are verified on-chain and immutable</p>
          <p className="mt-1">Building trust through transparency</p>
        </div>
      </div>
    </div>
  );
};

export default ImpactTracker;